MONGODB_URI=mongodb://username:password@host:27017/database?authSource=admin

AUTH_SECRET=replace-with-a-long-random-secret

# Optional Microsoft Entra ID provider. Leave all three blank to disable it.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Optional Google OAuth provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

ALLOWED_EMAIL_DOMAIN=iitg.ac.in
SUPER_ADMIN_EMAIL=admin@example.com

QR_SIGNING_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# Public URL used in generated QR links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
